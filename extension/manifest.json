{
  "manifest_version": 3,
  "name": "DeCaptcha Assist",
  "version": "1.0",
  "description": "A local-only CAPTCHA test and owner-only assistive solver.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5500/*"
      ],
      "js": [
        "content_script.js"
        ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeCaptcha Assist"
  },
  "background": {
    "service_worker": "background.js"
  }
}